# Speaker Signal — Docker Compose / Atlas
# Copy to `.env` before `docker compose up --build`.
#
# Atlas Network Access must allow the Docker host IP (or 0.0.0.0/0 for demos).

# Required for agent persistence (ingestion / intelligence / gtm).
# Services still boot without it; results are returned but not stored.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Optional. When unset, agents use deterministic scrape/score/draft fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional. Dashboard /api/analyze Firecrawl v2 preview (speaker-signal).
FIRECRAWL_API_KEY=fc-your-key

# One pipeline: empty URL → sample fixture; URL → Agent 1. Both score via Agent 2.
# NEXT_PUBLIC_DEMO_MODE is unused (kept only for older Compose builds).

# Per-service DB names (Compose overrides these; set here for local runs).
# MONGODB_DB=speaker_signal_ingestion   # Agent 1
# MONGODB_DB=speaker_signal_intelligence # Agent 2
# MONGODB_DB=speaker_signal_gtm          # Agent 3 (gtm-service)
# MONGODB_DB=project_radar_ingest        # Radar R1
# MONGODB_DB=project_radar_normalize     # Radar R2
# MONGODB_DB=project_radar_score         # Radar R3

# Project Radar agents (local defaults).
# RADAR_INGEST_PORT=8011
# RADAR_NORMALIZE_PORT=8012
# RADAR_SCORE_PORT=8013
# RADAR_INGEST_API_URL=http://localhost:8011
# RADAR_NORMALIZE_API_URL=http://localhost:8012
# RADAR_SCORE_API_URL=http://localhost:8013

# Agent 3 / GTM outreach + SMTP (optional).
# Local demo: SEND_MODE=real + SMTP_* sends draft copies to TEST_TO_EMAIL (team inbox only).
# Render locks SEND_MODE=mock — draft only, no automatic sending.
SEND_MODE=mock
SENDER_NAME=Kirill Cheldishkin
SENDER_COMPANY=Candid
SENDER_EMAIL=info@jobersteadt.com
TEST_TO_EMAIL=faruquitaymur@gmail.com
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=info@jobersteadt.com
