# HTTP server (GTM_PORT keeps Agent 3 on 8003 even when a shared .env sets PORT)
GTM_PORT=8003
HOST=0.0.0.0

# OpenAI (optional). When unset, sequence drafts use deterministic templates.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# MongoDB Atlas (optional). When unset, sequences/funnel stay in-memory only.
MONGODB_URI=
MONGODB_DB=speaker_signal_gtm
MONGODB_SEQUENCES_COLLECTION=sequences
MONGODB_FUNNEL_EVENTS_COLLECTION=funnel_events

# SMTP (Zoho). SEND_MODE=real requires SMTP_USER + SMTP_PASSWORD.
SEND_MODE=mock
SENDER_NAME=Kirill Cheldishkin
SENDER_EMAIL=info@jobersteadt.com
TEST_TO_EMAIL=faruquitaymur@gmail.com
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=info@jobersteadt.com
