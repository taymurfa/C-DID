# Optional. Used only by the standalone /api/analyze Firecrawl preview route.
FIRECRAWL_API_KEY=fc-your-key

# Dashboard defaults to Demo mode. Set false to start in Live agents mode.
NEXT_PUBLIC_DEMO_MODE=true

# Person 2 qualification / live pipeline (server-side only; Compose injects these)
# Agent 1 — ingestion
INGESTION_API_URL=http://localhost:8001
INGESTION_URL=http://localhost:8001
# Agent 2 — intelligence (live score brain)
INTELLIGENCE_API_URL=http://localhost:8002
# Agent 3 — GTM sequences + funnel
GTM_API_URL=http://localhost:8003

# Optional. Embedded Person 2 / local sequence fallback when agents are down.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
