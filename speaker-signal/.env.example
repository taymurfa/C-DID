# Optional. Without this key, the app remains fully usable in Demo data mode.
FIRECRAWL_API_KEY=fc-your-key

# Person 2 qualification pipeline (/api/qualify)
# Optional. Without a key, ICP fit + "why this person matters" fall back to
# deterministic scoring. Copy these from the shared backend/.env if you have it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Base URL of Agent 1 (speaker-signal-ingestion) used when /api/qualify is given
# a conferenceUrl instead of a raw ingestion payload.
INGESTION_URL=http://localhost:8001
