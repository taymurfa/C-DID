# Copy to .env.local (never commit .env.local).

# Speaker Signal agents (local defaults match root docker compose ports).
INGESTION_URL=http://localhost:8001
INTELLIGENCE_URL=http://localhost:8002
GTM_URL=http://localhost:8003
# Optional aliases:
# INGESTION_API_URL=http://localhost:8001
# INTELLIGENCE_API_URL=http://localhost:8002
# GTM_API_URL=http://localhost:8003

# Project Radar agents (R1–R3).
RADAR_INGEST_API_URL=http://localhost:8011
RADAR_NORMALIZE_API_URL=http://localhost:8012
RADAR_SCORE_API_URL=http://localhost:8013

# Optional. Used only by /api/analyze Firecrawl preview; qualify uses Agents 1/2.
# FIRECRAWL_API_KEY=fc-your-key
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# NEXT_PUBLIC_DEMO_MODE=true
