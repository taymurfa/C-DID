{
  "name": "intelligence-service",
  "version": "0.1.0",
  "description": "Standalone sales-intelligence service (Agent 2): raw scraped conference data -> normalized, deduplicated, ICP-scored, ranked qualified leads with explanations.",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "leads:list": "tsx scripts/list-qualifications.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.1",
    "mongodb": "^6.13.0",
    "openai": "^4.83.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
