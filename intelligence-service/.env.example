# HTTP server (INTELLIGENCE_PORT keeps Agent 2 on 8002)
INTELLIGENCE_PORT=8002
HOST=0.0.0.0

# OpenAI (optional). When unset, the service falls back to deterministic scoring.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# MongoDB Atlas (optional). When unset, results are returned but not persisted.
MONGODB_URI=
MONGODB_DB=speaker_signal_intelligence
MONGODB_QUALIFICATIONS_COLLECTION=qualifications

# Lead qualification tuning
# Minimum total score (0-100) for a lead to be marked qualified.
QUALIFY_MIN_SCORE=45
# Roles that are eligible to become leads at all (comma separated).
QUALIFY_ELIGIBLE_ROLES=speaker,moderator,unknown
# Cap how many candidate leads OpenAI enriches per request (cost control).
QUALIFY_OPENAI_MAX_LEADS=40
