# HTTP server (INGESTION_PORT keeps Agent 1 on 8001 even when a shared
# backend/.env sets a generic PORT)
INGESTION_PORT=8001
HOST=0.0.0.0

# OpenAI (optional). When unset, the service falls back to deterministic parsing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# MongoDB Atlas (optional). When unset, runs are returned but not persisted.
MONGODB_URI=
MONGODB_DB=speaker_signal_ingestion
MONGODB_RUNS_COLLECTION=runs

# Crawl bounds and politeness
CRAWL_MAX_PAGES=12
CRAWL_MAX_DEPTH=2
CRAWL_CONCURRENCY=2
CRAWL_REQUEST_DELAY_MS=750
CRAWL_REQUEST_TIMEOUT_MS=20000
CRAWL_MAX_RETRIES=2
CRAWL_RETRY_BASE_MS=500
CRAWL_USER_AGENT=SpeakerSignalIngestionBot/0.1 (+https://example.com/bot)

# Respect robots.txt (set to "false" only for testing against permissive fixtures)
RESPECT_ROBOTS=true

# Event-driven automation: automatically ingest a conference as soon as it is
# discovered (via /discover, or as a discoveredEvent during an /ingest run),
# instead of waiting for a manual /ingest call.
AUTO_INGEST_ENABLED=true
# Only auto-ingest events flagged relevant AND at/above this confidence (0-1).
AUTO_INGEST_MIN_CONFIDENCE=0.6
# How many auto-triggered ingestion runs may execute concurrently.
AUTO_INGEST_CONCURRENCY=1
# How far to follow chained discoveries (0 = only direct hits).
AUTO_INGEST_MAX_DEPTH=1
# Page budget per auto-triggered run (defaults to CRAWL_MAX_PAGES).
AUTO_INGEST_MAX_PAGES=12

# Start grabbing on boot: comma-separated seed pages to discover from at startup
# (each relevant hit is auto-ingested). Leave empty to wait for manual calls.
BOOTSTRAP_SEEDS=
BOOTSTRAP_MAX_PER_SEED=10

# Hand-off to Agent 2: after each run, POST the result to the intelligence
# service's /qualify so leads get scored end-to-end.
HANDOFF_ENABLED=true
INTELLIGENCE_URL=http://localhost:8002
HANDOFF_TIMEOUT_MS=120000
