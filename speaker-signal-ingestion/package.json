{
  "name": "speaker-signal-ingestion",
  "version": "0.1.0",
  "description": "Standalone conference ingestion service: URL -> discover pages -> fetch public content -> structured conference data.",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "runs:list": "tsx scripts/list-runs.ts",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "cheerio": "^1.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.1",
    "mongodb": "^6.13.0",
    "openai": "^4.83.0",
    "p-limit": "^6.2.0",
    "playwright": "^1.50.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
